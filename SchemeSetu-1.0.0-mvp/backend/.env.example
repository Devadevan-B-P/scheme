# Environment
ENVIRONMENT=development
DEBUG=True

# Database — PyMongo Async
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=schemesetu

# AI / LLM — env configurable
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloud DLP (Tier 2 defense-in-depth, MockDlpClient used by default in dev/test)
DLP_ENABLED=false
DLP_INTEGRATION_TESTS=false
GOOGLE_CLOUD_PROJECT=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Admin Seed Endpoint (Disabled by default, CLI is primary)
ENABLE_ADMIN_SEED_ENDPOINT=false
ADMIN_API_KEY=
